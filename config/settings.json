{
  "paths": {
    "input_dir": "data/input",
    "processed_dir": "data/processed",
    "reports_dir": "data/reports",
    "log_file": "logs/datake.log",
    "archive_dir": "data/archive",
    "quarantine_dir": "data/quarantine",
    "history_db": "data/datake.db"
  },
  "files": {
    "supported_extensions": [
      ".csv",
      ".xlsx",
      ".json",
      ".jsonl",
      ".parquet"
    ],
    "output_format": "csv"
  },
  "csv": {
    "encodings": ["utf-8", "utf-8-sig", "latin-1"],
    "delimiter": null
  },
  "logging": {
    "level": "INFO"
  },
  "automation": {
    "watch_interval": 5,
    "file_stability_seconds": 2
  },
  "validation": {
    "required_columns": ["customer_id", "email"],
    "date_columns": ["signup_date"],
    "numeric_columns": ["amount"],
    "unique_columns": ["customer_id"],
    "email_columns": ["email"],
    "numeric_constraints": {
      "amount": { "min": 0 }
    },
    "max_examples": 5
  },
  "cleaning": {
    "standardize_column_names": true,
    "column_aliases": {
      "Customer Name": "customer_name"
    },
    "fill_values": {
      "customer_name": "Unknown",
      "amount": 0
    },
    "drop_if_missing": ["customer_id", "email"],
    "drop_duplicates": true,
    "duplicate_subset": ["customer_id"],
    "duplicate_keep": "first",
    "date_format": "%Y-%m-%d",
    "drop_invalid_dates": true,
    "coerce_numeric": true,
    "drop_invalid_numeric": true,
    "clamp_numeric": true,
    "drop_invalid_emails": true
  },
  "profiles": {
    "lenient_customer_import": {
      "validation": {
        "required_columns": ["customer_id"],
        "email_columns": [],
        "unique_columns": ["customer_id"]
      },
      "cleaning": {
        "drop_if_missing": ["customer_id"]
      }
    }
  }
}
